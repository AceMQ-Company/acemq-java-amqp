<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.acemq</groupId>
  <artifactId>acemq-amqp-benchmarks</artifactId>
  <name>AceMQ AMQP Benchmarks</name>
  <version>0.2.8-SNAPSHOT</version>
  <description>JMH benchmarks. In the reactor rather than a separate repository so they
    measure the current commit: a benchmark that consumes a published snapshot attributes
    today's regression to yesterday's code. Built only under -Pbenchmarks.</description>
  <url>https://github.com/AceMQ-Company/acemq-java-amqp/acemq-amqp-benchmarks</url>
  <developers>
    <developer>
      <id>felipeg48</id>
      <name>Felipe Gutierrez</name>
      <organization>AceMQ</organization>
      <organizationUrl>https://acemq.com</organizationUrl>
    </developer>
  </developers>
  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <scm>
    <connection>scm:git:https://github.com/AceMQ-Company/acemq-java-amqp.git/acemq-amqp-benchmarks</connection>
    <developerConnection>scm:git:git@github.com:AceMQ-Company/acemq-java-amqp.git/acemq-amqp-benchmarks</developerConnection>
    <url>https://github.com/AceMQ-Company/acemq-java-amqp/acemq-amqp-benchmarks</url>
  </scm>
  <dependencies>
    <dependency>
      <groupId>org.openjdk.jmh</groupId>
      <artifactId>jmh-generator-annprocess</artifactId>
      <version>1.37</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.jspecify</groupId>
      <artifactId>jspecify</artifactId>
      <version>1.0.1</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.11.4</version>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <artifactId>junit-jupiter-engine</artifactId>
          <groupId>org.junit.jupiter</groupId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>3.27.7</version>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <artifactId>byte-buddy</artifactId>
          <groupId>net.bytebuddy</groupId>
        </exclusion>
      </exclusions>
    </dependency>
  </dependencies>
</project>
