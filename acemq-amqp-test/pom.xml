<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.acemq</groupId>
    <artifactId>acemq-amqp-parent</artifactId>
    <version>0.2.2-SNAPSHOT</version>
  </parent>

  <artifactId>acemq-amqp-test</artifactId>
  <name>AceMQ AMQP Test Kit</name>
  <description>Testing support: an in-memory transport implementing the same SPI, a Testcontainers harness and fluent assertions for retry and dead-letter outcomes.</description>

  <properties>
    <!-- This module's own tests are a fair measure of it, unlike the engine,
         which is covered from elsewhere and is gated by the aggregate report
         in acemq-amqp-coverage. Reason: the test kit is exercised by its own suites. -->
    <jacoco.line.coverage>0.80</jacoco.line.coverage>
    <jacoco.branch.coverage>0.60</jacoco.branch.coverage>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.acemq</groupId>
      <artifactId>acemq-amqp-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.acemq</groupId>
      <artifactId>acemq-transport-spi</artifactId>
    </dependency>
    <dependency>
      <groupId>org.acemq</groupId>
      <artifactId>acemq-amqp-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.acemq</groupId>
      <artifactId>acemq-amqp-patterns</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>rabbitmq</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.awaitility</groupId>
      <artifactId>awaitility</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-params</artifactId>
    </dependency>
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The outbox is SQL, so testing it needs a database. H2 runs in the unit
         suite because it starts in milliseconds and catches every syntax and
         mapping error; PostgreSQL runs in the integration suite because the
         concurrent-claim behaviour is a property of a real engine and H2
         agreeing about it would prove nothing. -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Test scope only, and only for the outbox integration test: proving that a
         committed message reaches a consumer needs a real broker, and the in-memory
         transport this module ships would be proving something about itself. -->
    <dependency>
      <groupId>org.acemq</groupId>
      <artifactId>acemq-transport-rabbitmq</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Test scope: XML is not a dependency of the engine, and its being discovered
         here rather than compiled in is exactly what the registry tests check. -->
    <dependency>
      <groupId>org.acemq</groupId>
      <artifactId>acemq-amqp-codec-xml</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.acemq</groupId>
      <artifactId>acemq-amqp-codec-yaml</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.acemq</groupId>
      <artifactId>acemq-amqp-codec-avro</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.acemq</groupId>
      <artifactId>acemq-amqp-codec-protobuf</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Telemetry providers are optional for users of the library, so they are test
         scope here: their presence is exactly what these tests exercise. -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-sdk</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-sdk-testing</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
