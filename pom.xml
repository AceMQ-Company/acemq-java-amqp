  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven.compiler.plugin.version}</version>
          <configuration>
            <release>${maven.compiler.release}</release>
            <compilerArgs>
              <arg>-Xlint:all,-serial,-processing</arg>
            </compilerArgs>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven.surefire.plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>${maven.failsafe.plugin.version}</version>
          <configuration>
            <!-- @{} rather than ${}: a POM property is interpolated when the model
                 is built, which resolves this to the empty default long before
                 JaCoCo sets it, so integration-test coverage is silently lost.
                 Surefire and Failsafe evaluate @{} late, at execution time. -->
            <argLine>@{failsafeArgLine}</argLine>
          </configuration>
          <executions>
            <execution>
              <goals>
                <goal>integration-test</goal>
                <goal>verify</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-javadoc-plugin</artifactId>
          <version>${maven.javadoc.plugin.version}</version>
          <configuration>
            <doclint>all,-missing</doclint>
            <quiet>true</quiet>
            <!-- @apiNote, @implSpec and @implNote are standard tags, but javadoc only
                 recognises them for the JDK's own build unless a project declares them.
                 Undeclared, they are "unknown tag" errors that fail the javadoc jar and
                 so fail the release, while every ordinary build passes. -->
            <tags>
              <tag>
                <name>apiNote</name>
                <placement>a</placement>
                <head>API Note:</head>
              </tag>
              <tag>
                <name>implSpec</name>
                <placement>a</placement>
                <head>Implementation Requirements:</head>
              </tag>
              <tag>
                <name>implNote</name>
                <placement>a</placement>
                <head>Implementation Note:</head>
              </tag>
            </tags>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-source-plugin</artifactId>
          <version>${maven.source.plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-gpg-plugin</artifactId>
          <version>${maven.gpg.plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>com.github.siom79.japicmp</groupId>
          <artifactId>japicmp-maven-plugin</artifactId>
          <version>${japicmp.plugin.version}</version>
          <configuration>
            <skipXmlReport>true</skipXmlReport>
            <parameter>
              <!-- Nothing has been released yet, so there is no previous version
                   to compare against. Wiring it now rather than later means the
                   first release is also the moment the gate starts working,
                   instead of the moment someone remembers to add it. -->
              <ignoreMissingOldVersion>true</ignoreMissingOldVersion>
              <onlyModified>true</onlyModified>
              <!-- A binary-incompatible change on anything but a major version is
                   a broken upgrade for every consumer, so it fails the build.
                   Source incompatibility is reported but tolerated while 0.x. -->
              <breakBuildOnBinaryIncompatibleModifications>true</breakBuildOnBinaryIncompatibleModifications>
              <breakBuildOnSourceIncompatibleModifications>false</breakBuildOnSourceIncompatibleModifications>
              <includes>
                <include>org.acemq.amqp</include>
              </includes>
              <excludes>
                <!-- Internal implementations; only the API and SPI are promises. -->
                <exclude>org.acemq.amqp.core.Default*</exclude>
                <exclude>org.acemq.amqp.core.*Telemetry*</exclude>
                <exclude>org.acemq.amqp.transport.rabbitmq.RabbitMqConnection</exclude>
              </excludes>
            </parameter>
          </configuration>
          <executions>
            <execution>
              <id>api-compatibility</id>
              <phase>verify</phase>
              <goals><goal>cmp</goal></goals>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <!-- Build environment gate: the toolchain must be new enough even though
           we emit Java 11 bytecode. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>${maven.enforcer.plugin.version}</version>
        <executions>
          <execution>
            <id>enforce-build-environment</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <requireMavenVersion>
                  <version>[3.8.0,)</version>
                </requireMavenVersion>
                <requireJavaVersion>
                  <version>[${build.jdk.min},)</version>
                  <message>Build with JDK ${build.jdk.min} or newer. The published
                    bytecode still targets Java ${java.baseline}.</message>
                </requireJavaVersion>
                <banDuplicatePomDependencyVersions/>
                <requireUpperBoundDeps/>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Formatting is enforced, not suggested: `mvn spotless:apply` fixes. -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.plugin.version}</version>
        <configuration>
          <java>
            <!-- The Eclipse formatter is used rather than google-java-format or
                 palantir-java-format because those reach into javac internals and
                 break on newer JDKs (palantir fails outright on JDK 25). Formatting
                 must give the same result on a contributor's JDK and in CI. -->
            <eclipse>
              <file>${maven.multiModuleProjectDirectory}/etc/eclipse-formatter.xml</file>
            </eclipse>
            <removeUnusedImports/>
            <importOrder>
              <order>java,javax,org,com,</order>
            </importOrder>
            <trimTrailingWhitespace/>
            <endWithNewline/>
            <licenseHeader>
              <file>${maven.multiModuleProjectDirectory}/etc/license-header.txt</file>
            </licenseHeader>
          </java>
          <!-- POM element order is deliberate and carries explanatory comments,
               so it is left to humans. Java formatting is machine-enforced. -->
        </configuration>
        <executions>
          <execution>
            <id>spotless-check</id>
            <phase>validate</phase>
            <goals><goal>check</goal></goals>
          </execution>
        </executions>
      </plugin>

      <!-- Declared here, not merely managed: a plugin left in pluginManagement is
           configured but never bound, so *IT tests are skipped and the build still
           passes. An integration suite that silently does not run is worse than one
           that fails. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <version>${maven.failsafe.plugin.version}</version>
      </plugin>

      <plugin>
        <groupId>com.github.siom79.japicmp</groupId>
        <artifactId>japicmp-maven-plugin</artifactId>
      </plugin>

      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.plugin.version}</version>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals><goal>prepare-agent</goal></goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>test</phase>
            <goals><goal>report</goal></goals>
          </execution>
          <!-- Integration tests exercise a great deal of the engine, and without
               these two the whole of it is invisible to coverage: the agent is
               only attached to surefire otherwise. -->
          <execution>
            <id>prepare-agent-integration</id>
            <goals><goal>prepare-agent-integration</goal></goals>
            <configuration>
              <!-- Both prepare-agent goals default to writing the argLine property,
                   so the second overwrites the first and one of the two agents is
                   silently lost. Failsafe is pointed at this one explicitly. -->
              <propertyName>failsafeArgLine</propertyName>
            </configuration>
          </execution>
          <execution>
            <id>report-integration</id>
            <phase>post-integration-test</phase>
            <goals><goal>report-integration</goal></goals>
          </execution>
          <execution>
            <id>coverage-gate</id>
            <phase>verify</phase>
            <goals><goal>check</goal></goals>
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${jacoco.line.coverage}</minimum>
                    </limit>
                    <limit>
                      <counter>BRANCH</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${jacoco.branch.coverage}</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Keeps ${project.version} out of the published POMs' dependency
           declarations, so consumers never see the CI-resolved revision. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>flatten-maven-plugin</artifactId>
        <version>${flatten.plugin.version}</version>
        <configuration>
          <updatePomFile>true</updatePomFile>
          <flattenMode>ossrh</flattenMode>
        </configuration>
        <executions>
          <execution>
            <id>flatten</id>
            <phase>process-resources</phase>
            <goals><goal>flatten</goal></goals>
          </execution>
          <execution>
            <id>flatten-clean</id>
            <phase>clean</phase>
            <goals><goal>clean</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <!-- Snapshots and pre-release builds go to GitHub Packages; tagged releases
       additionally go to Maven Central. See docs: GitHub Packages requires
       authentication even for public artifacts, so it cannot be the only
       distribution channel for an open-source library. -->
  <distributionManagement>
    <repository>
      <id>github</id>
      <name>GitHub AceMQ-Company Apache Maven Packages</name>
      <url>https://maven.pkg.github.com/AceMQ-Company/acemq-java-amqp</url>
    </repository>
    <snapshotRepository>
      <id>github</id>
      <name>GitHub AceMQ-Company Apache Maven Packages</name>
      <url>https://maven.pkg.github.com/AceMQ-Company/acemq-java-amqp</url>
    </snapshotRepository>
  </distributionManagement>

  <profiles>
    <!-- Benchmarks are slow and are not part of an ordinary build. ADR-017 keeps
         them in the reactor so they measure the current commit rather than a
         published snapshot, and behind this profile so nobody waits for them. -->
    <profile>
      <id>benchmarks</id>
      <modules>
        <module>acemq-amqp-benchmarks</module>
      </modules>
    </profile>

    <!-- Static analysis. ErrorProne compiles against javac internals, so it
         trails new JDK releases by months; running the build on a JDK it does
         not yet support fails the compile outright rather than degrading. The
         profile therefore covers 21 up to but not including 24, matching CI's
         JDK 21 job. The 17 and 25 jobs build the same code without it, so
         nothing goes unbuilt — only unanalysed.

         The lower bound is 21 rather than 17 because -XDaddTypeAnnotationsToSymbol
         is required by ErrorProne from 21 onward and does not exist before it,
         and javac rejects an unknown option outright. Raise the upper bound when
         ErrorProne supports the next JDK. -->
    <profile>
      <id>static-analysis</id>
      <activation>
        <jdk>[21,24)</jdk>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-compiler-plugin</artifactId>
            <configuration>
              <compilerArgs>
                <arg>-Xlint:all,-serial,-processing</arg>
                <arg>-XDcompilePolicy=simple</arg>
                <arg>--should-stop=ifError=FLOW</arg>
                <!-- Required by ErrorProne from JDK 21 onwards; without it the
                     compiler refuses outright and says so. -->
                <arg>-XDaddTypeAnnotationsToSymbol=true</arg>
                <!-- NullAway is told which packages it owns; everything else is
                     treated as unannotated and left alone.

                     It reports as a warning rather than an error, and the roughly
                     fifty findings today are almost all the same shape: builder
                     fields are null until build() is called, which NullAway cannot
                     know without @Nullable on them. Adding those annotations means
                     adding JSpecify, and acemq-amqp-api is documented as having no
                     third-party dependencies, so that is a deliberate decision
                     rather than a tidy-up. JSpecify at provided scope would keep
                     the promise for consumers; it is the obvious next step and is
                     recorded as one instead of being taken silently here. -->
                <arg>-Xplugin:ErrorProne \
                  -XepOpt:NullAway:AnnotatedPackages=org.acemq.amqp \
                  -XepOpt:NullAway:JSpecifyMode=true \
                  -XepOpt:NullAway:TreatGeneratedAsUnannotated=true \
                  -Xep:NullAway:ERROR \
                  -Xep:MissingSummary:OFF \
                  -XepExcludedPaths:(.*/target/generated-sources/.*|.*/src/test/java/.*)</arg>
              </compilerArgs>
              <annotationProcessorPaths>
                <path>
                  <groupId>com.google.errorprone</groupId>
                  <artifactId>error_prone_core</artifactId>
                  <version>${errorprone.version}</version>
                </path>
                <path>
                  <groupId>com.uber.nullaway</groupId>
                  <artifactId>nullaway</artifactId>
                  <version>${nullaway.version}</version>
                </path>
              </annotationProcessorPaths>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!-- mvn -Prelease deploy : signed sources+javadoc, for Maven Central -->
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals><goal>jar-no-fork</goal></goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals><goal>jar</goal></goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals><goal>sign</goal></goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
